{
  "translations": [
    {
      "id": "E6400",
      "en": "\"You still mean to go farther?",
      "status": "translated",
      "note": ""
    },
    {
      "id": "E6401",
      "en": "Unless you can answer my questions,",
      "status": "translated",
      "note": ""
    },
    {
      "id": "E6402",
      "en": "that wish cannot be granted.\"",
      "status": "translated",
      "note": ""
    },
    {
      "id": "E6403",
      "en": "\"Give me your answer...\"",
      "status": "translated",
      "note": ""
    },
    {
      "id": "E6404",
      "en": "\"A trickster has stolen the treasure from a treasure chest.",
      "status": "review",
      "note": "Localized the language-specific trickster/chest wordplay so the empty-chest answer remains solvable in English. E0680.evt branches verified: choice 3 succeeds; order and branch indices unchanged. Requires in-game functional review."
    },
    {
      "id": "E6405",
      "en": "What is left inside that chest...?\"",
      "status": "review",
      "note": "Continuation of the localized riddle in E6404. Empty chest remains correct choice 3, verified in E0680.evt bytecode."
    },
    {
      "id": "E6406",
      "en": "A spinning top",
      "status": "translated",
      "note": ""
