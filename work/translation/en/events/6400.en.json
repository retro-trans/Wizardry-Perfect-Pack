      "en": "Then prepare yourself for the consequences.",
      "status": "translated",
      "note": ""
    },
    {
      "id": "E6429",
      "en": "Answer my question.\"",
      "status": "translated",
      "note": ""
    },
    {
      "id": "E6430",
      "en": "\"Among this labyrinth's many doors,",
      "status": "translated",
      "note": ""
    },
    {
      "id": "E6431",
      "en": "which kind was more common:",
      "status": "translated",
      "note": ""
