    {
      "id": "E6436",
      "en": "I don't know!",
      "status": "translated",
      "note": ""
    },
    {
      "id": "E6437",
      "en": "\"Incorrect...",
      "status": "translated",
      "note": ""
    },
    {
      "id": "E6438",
      "en": "You have shown me your resolve.\"",
      "status": "translated",
      "note": ""
    },
